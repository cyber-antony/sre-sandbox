  <diagram id="sre-page-2" name="02 - Disk dependencies and lifetime">
    <mxGraphModel dx="1660" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SRE Sandbox | Disk dependencies and lifetime" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#f8fafc;strokeColor=#f8fafc;fontColor=#0f172a;fontFamily=Helvetica;fontSize=26;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1580" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Purple arrows: overlay -&gt; backing file. Blue dashed arrows: NFS. Grey arrow: filesystem containment." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#f8fafc;strokeColor=#f8fafc;fontColor=#0f172a;fontFamily=Helvetica;fontSize=16;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1580" height="45" as="geometry" />
        </mxCell>
        <mxCell id="base" value="L0 / lab | persistent base image&#10;/srv/vm-images/ubuntu-24.04-server-cloudimg-amd64.img&#10;Used locally for mainhost and remotely for the cluster nodes.&#10;Do not remove or replace while dependent overlays are in use." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontFamily=Helvetica;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="550" y="170" width="580" height="145" as="geometry" />
        </mxCell>
        <mxCell id="overlay" value="L0 file / L1 root disk&#10;/var/lib/libvirt/images/mainhost.qcow2&#10;120G virtual; writable overlay&#10;Its guest filesystem contains the node disk files." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;fontFamily=Helvetica;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="500" height="155" as="geometry" />
        </mxCell>
        <mxCell id="mount" value="L1 / mainhost | read-only NFS mount&#10;/mnt/vm-images/ubuntu-24.04-server-cloudimg-amd64.img&#10;NFS view of the same physical base file on lab." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontFamily=Helvetica;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="830" y="440" width="730" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nodes" value="L1 files / L2 root disks&#10;/opt/sre-lab/libvirt/vm-disks/&#10;cc1.qcow2 | wk1.qcow2 | wk2.qcow2&#10;Each node overlay refers to the base image at the mounted NFS path.&#10;Each has its own cloud-init seed.iso; seed ISOs are not backing images." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#0f172a;fontFamily=Helvetica;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="830" y="700" width="730" height="160" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="L0 / lab | PostgreSQL persistent files&#10;/srv/postgres/taskmanager-postgres&#10;Independent of mainhost and node root disks.&#10;PV reclaim policy: Retain." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontFamily=Helvetica;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="920" width="500" height="145" as="geometry" />
        </mxCell>
        <mxCell id="pod" value="Kubernetes PostgreSQL container&#10;PV/PVC mounts the NFS subdirectory.&#10;Scheduling does not change the physical storage location." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontFamily=Helvetica;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="830" y="980" width="730" height="100" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="Deleting mainhost.qcow2 also loses its nested VM disk files. Deleting node overlays loses node-local state.&#10;PostgreSQL files and the base image remain on lab. Virtual disk capacities are not preallocated physical usage." style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Helvetica;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="1140" width="1490" height="65" as="geometry" />
        </mxCell>
